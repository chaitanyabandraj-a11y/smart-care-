# SmartCare OPD & Doctor Portal Configuration
PORT=5000
NODE_ENV=development

# OPD Cryptographic QR & HMAC Secret (used for signing secure patient identity QR tokens)
OPD_QR_SECRET=SMARTCARE_OPD_SECURE_TOKEN_2026

# Database Directory (Defaults to backend/data/opd/opd.db)
OPD_DB_PATH=./data/opd/opd.db

# Frontend App URL (for CORS and Socket.IO origin)
FRONTEND_URL=http://localhost:3000
